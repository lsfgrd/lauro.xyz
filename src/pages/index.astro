---
import Layout from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import Page from "../layouts/Page.astro";

const seo = {
  title: "Lauro Figueiredo",
  description: "Dog dad. Web developer. RPG enthusiast.",
};
---

<Page seo={seo}>
  <p>Welcome to my website :)</p>

  <p>
    This is my little corner of the internet, where I share whatever I feel
    like: things I've learned, personal texts (mostly in Portuguese) and some
    random lists about myself.
  </p>

  <p>
    If you want to know who I am, <a href="/about">start here</a>!
  </p>

  <p>
    And if you're feeling curious, there are a few hidden corners too: meet my
    dog <a href="/pacoca">Paçoca</a> or check out the{" "}
    <a href="/nope">things I have absolutely no interest in</a>.
  </p>

  <hr />

  <p class="ai-note">
    AI doesn't write for me, but I use it for manual tasks. <a href="/ai">AI note</a>
  </p>

</Page>

<style>
  .ai-note {
    font-size: 0.9rem;
    color: var(--muted-color);
  }
</style>
