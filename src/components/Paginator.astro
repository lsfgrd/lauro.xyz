---
const { page } = Astro.props;
---

<nav class="pagination" aria-label="Pagination">
  {page.url.prev && <a href={page.url.prev} class="btn" title="Go to Previous">&larr; prev</a>}
  {page.url.next && <a href={page.url.next} class="btn" title="Go to Next">next &rarr;</a>}
</nav>

<style>
  .pagination {
    display: flex;
    justify-content: space-between;
    margin: 2rem 0;
  }

  .pagination a:only-child[title="Go to Next"] {
    margin-left: auto;
  }
</style>
