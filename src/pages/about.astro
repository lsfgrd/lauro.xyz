---
import Page from "../layouts/Page.astro";

const seo = {
  title: "About | Lauro",
  description: "",
};

const birthdate = new Date(1998, 11, 23);
const ageDifMs = Date.now() - birthdate.getTime();
const ageDate = new Date(ageDifMs);
const age = Math.abs(ageDate.getUTCFullYear() - 1970);

const photos = [
  {
    src: "/assets/me/eu6.jpg",
    alt: "Me wearing round red sunglasses and a sunflower shirt on a city street at night",
  },
  {
    src: "/assets/me/eu1.jpg",
    alt: "Selfie of me holding a mandolin and a yellow pick",
  },
  {
    src: "/assets/me/eu2.jpg",
    alt: "Me smiling and raising a cup of beer at a rock concert",
  },
  {
    src: "/assets/me/eu4.jpg",
    alt: "Me grinning in a crowded medieval-themed tavern",
  },
  {
    src: "/assets/me/eu5.jpg",
    alt: "Me in a red sleeveless shirt with a bicycle print",
  },
  {
    src: "/assets/me/eu3.jpg",
    alt: "Night selfie of me in a red tank top, resting my face on my hand",
  },
];
---

<Page seo={seo}>
  <ul class="facts">
    <li>
      <span class="facts__icon" aria-hidden="true">
        🪪
      </span>
      <span>Lauro Figueiredo</span>
    </li>
    <li>
      <span class="facts__icon" aria-hidden="true">
        🎂
      </span>
      <span>{age} years old</span>
    </li>
    <li>
      <span class="facts__icon" aria-hidden="true">
        👤
      </span>
      <span>He/him</span>
    </li>
    <li>
      <span class="facts__icon" aria-hidden="true">
        📍
      </span>
      <span>
        <a
          href="https://www.openstreetmap.org/relation/368782#map=13/-19.9358/-43.9040"
          target="_blank"
        >
          Belo Horizonte, Brazil
        </a>
      </span>
    </li>
    <li>
      <span class="facts__icon" aria-hidden="true">
        💻
      </span>
      <span>
        Senior Software Engineer (check <a href="/work">work</a>)
      </span>
    </li>
  </ul>
  <section class="collage" aria-label="Photos of me">
    {photos.map(({ src, alt }) => (
      <figure class="collage__item">
        <img
          src={src}
          alt={alt}
          width="1200"
          height="1600"
          loading="lazy"
          decoding="async"
        />
      </figure>
    ))}
  </section>
  Check my <a href="/interests">interests!</a>
</Page>

<style>
  .facts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: baseline;
    margin: 0.5rem 0;
  }

  .facts__icon {
    text-align: left;
  }

  .collage {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem 1.25rem;
    margin: 2.5rem 0;
    padding: 0 0.25rem;
  }

  .collage__item {
    margin: 0;
    padding: 0.6rem 0.6rem 2.75rem;
    background: #fbfaf6;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.25),
      0 6px 14px rgb(0 0 0 / 0.2);
    transform: rotate(var(--tilt));
  }

  .collage__item:nth-child(6n + 1) {
    --tilt: -2.5deg;
  }
  .collage__item:nth-child(6n + 2) {
    --tilt: 1.5deg;
  }
  .collage__item:nth-child(6n + 3) {
    --tilt: -1deg;
  }
  .collage__item:nth-child(6n + 4) {
    --tilt: 1.75deg;
  }
  .collage__item:nth-child(6n + 5) {
    --tilt: -2deg;
  }
  .collage__item:nth-child(6n + 6) {
    --tilt: 2.5deg;
  }

  .collage__item img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 40%;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
  }

  @media screen and (max-width: 600px) {
    .collage {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem 1rem;
    }

    .collage__item {
      padding: 0.45rem 0.45rem 2rem;
    }
  }
</style>
