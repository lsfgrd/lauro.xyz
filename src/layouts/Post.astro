---
import ArticleSchema from "../components/ArticleSchema.astro";
import Page from "./Page.astro";
import { Image } from "astro:assets";

const { frontmatter } = Astro.props;
const ogImage = `/og/${Astro.url.pathname.replace(/^\/|\/$/g, "")}.png`;
---

<Page seo={{ ...frontmatter, image: ogImage }} lang={frontmatter.lang}>
  <Fragment slot="head-bottom">
    <ArticleSchema {...frontmatter} />
  </Fragment>
  <article class="post-content__article">
    <h1>{frontmatter.title}</h1>
    <time>{frontmatter.publishDate}</time>
    {
      frontmatter.image && (
        <Image
          src={frontmatter.image}
          alt={frontmatter.alt}
          width={700}
          height={350}
          loading="eager"
          class="post-main__img"
        />
      )
    }
    <slot />
    {
      frontmatter.notAI && (
        <>
          <p>...</p>
          <a class="not_ai" href="https://notbyai.fyi/" target="_blank">
            <Image
              src="/assets/notAI.png"
              alt="Written by a human, not by AI"
              width={131}
              height={42}
              loading="lazy"
            />
          </a>
        </>
      )
    }
  </article>
</Page>

<style>
  .post-content__article > h1 {
    margin-bottom: 0.25rem;
    font-size: 2rem;
  }

  .post-main__img {
    width: 100%;
    height: auto;
    margin: 1.5rem 0;
    border: var(--border-width) solid var(--text-color);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--accent-color);
  }

  .not_ai {
    display: inline-block;
    text-decoration: none;
  }

  .not_ai::after {
    content: none !important;
  }

</style>
