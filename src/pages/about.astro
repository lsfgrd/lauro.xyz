---
import Page from "../layouts/Page.astro";

const seo = {
  title: "About",
  description: "",
};

const birthdate = new Date(1998, 11, 23);
const ageDifMs = Date.now() - birthdate.getTime();
const ageDate = new Date(ageDifMs);
const age = Math.abs(ageDate.getUTCFullYear() - 1970);

const photos = [
  {
    src: "/assets/me/eu6.jpg",
    caption: "Night out in the city",
    alt: "Me wearing round red sunglasses and a sunflower shirt on a city street at night",
  },
  {
    src: "/assets/me/eu1.jpg",
    caption: "Mandolin time",
    alt: "Selfie of me holding a mandolin and a yellow pick",
  },
  {
    src: "/assets/me/eu2.jpg",
    caption: "McMiners concert, cold beer",
    alt: "Me smiling and raising a cup of beer at a McMiners concert",
  },
  {
    src: "/assets/me/eu4.jpg",
    caption: "Medieval tavern, naturally",
    alt: "Me grinning in a crowded medieval-themed tavern",
  },
  {
    src: "/assets/me/eu5.jpg",
    caption: "Bicycle shirt",
    alt: "Me in a red sleeveless shirt with a bicycle print",
  },
  {
    src: "/assets/me/eu3.jpg",
    caption: "Late night thoughts",
    alt: "Night selfie of me in a red tank top, resting my face on my hand",
  },
];
---

<Page seo={seo}>
  <ul class="facts">
    <li>
      <span class="facts__icon" aria-hidden="true">
        🪪
      </span>
      <span>Lauro Figueiredo</span>
    </li>
    <li>
      <span class="facts__icon" aria-hidden="true">
        🎂
      </span>
      <span>{age} years old</span>
    </li>
    <li>
      <span class="facts__icon" aria-hidden="true">
        👤
      </span>
      <span>He/him</span>
    </li>
    <li>
      <span class="facts__icon" aria-hidden="true">
        📍
      </span>
      <span>
        <a
          href="https://www.openstreetmap.org/relation/368782#map=13/-19.9358/-43.9040"
          target="_blank"
        >
          Belo Horizonte, Brazil
        </a>
      </span>
    </li>
    <li>
      <span class="facts__icon" aria-hidden="true">
        💻
      </span>
      <span>
        Senior Software Engineer (check <a href="/work">work</a>)
      </span>
    </li>
    <li>
      <span class="facts__icon" aria-hidden="true">
        🗣️
      </span>
      <span>Brazilian Portuguese (native), English, Italian, Portuñol</span>
    </li>
    <li>
      <span class="facts__icon" aria-hidden="true">
        ✉️
      </span>
      <span>laurofgrd(at)gmail.com</span>
    </li>
    <li>
      <span class="facts__icon" aria-hidden="true">
        🦋
      </span>
      <span>
        <a href="https://bsky.app/profile/lauro.xyz" target="_blank">
          Bluesky
        </a>
      </span>
    </li>
  </ul>
  <section class="collage" aria-label="Photos of me">
    {photos.map(({ src, alt, caption }) => (
      <figure class="collage__item">
        <img
          src={src}
          alt={alt}
          width="1200"
          height="1600"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{caption}</figcaption>
      </figure>
    ))}
  </section>
  <h2>More you may want to know</h2>
  <ul>
    <li><a href="/interests">Interests</a>;</li>
    <li><a href="/pacoca">Paçoca</a>, my dog;</li>
    <li><a href="/defaults">Defaults</a> (the apps and tools I currently use);</li>
    <li><a href="/nope">Things I have absolutely no interest in</a>;</li>
    <li><a href="/ai">My stance on AI</a>;</li>
    <li><a href="/colophon">Colophon</a> (how this site is built).</li>
  </ul>
</Page>

<style>
  .facts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: baseline;
    margin: 0.5rem 0;
  }

  .facts__icon {
    text-align: left;
  }

  .collage {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin: 2.5rem 0;
  }

  .collage__item {
    margin: 0;
  }

  .collage__item img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 40%;
    border: var(--border-width) solid var(--text-color);
    box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--accent-color);
  }

  .collage__item figcaption {
    margin-top: 0.75rem;
    color: var(--text-color);
    font-size: 0.85rem;
    text-align: center;
  }

  @media screen and (max-width: 600px) {
    .collage {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem 1rem;
    }
  }
</style>
