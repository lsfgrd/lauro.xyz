<script>
  document.addEventListener("DOMContentLoaded", () => {
    const links = document.querySelectorAll(".navbar__link");

    links.forEach((link) => {
      link.addEventListener("click", (event) => {
        const id = link.getAttribute("href")?.substring(1);
        const section = document.querySelector(`section[id="${id}"]`);

        if (section) {
          document.querySelectorAll("section[id]").forEach((sec) => {
            sec.classList.remove("section--active");
          });

          section.classList.add("section--active");

          setTimeout(() => {
            section.classList.remove("section--active");
          }, 1000);
        }
      });
    });
  });
</script>

<nav class="navbar">
  <input
    type="checkbox"
    id="menuToggle"
    class="navbar__toggle"
    aria-hidden="true"
    hidden
  />
  <label for="menuToggle" class="navbar__hamburger" aria-label="Toggle menu">
    ☰ Skip to
  </label>
  <ul class="navbar__menu">
    <li class="navbar__item">
      <a href="#about" class="navbar__link">
        About
      </a>
    </li>
    <li class="navbar__item">
      <a href="#technologies" class="navbar__link">
        Technologies
      </a>
    </li>
    <li class="navbar__item">
      <a href="#experience" class="navbar__link">
        Experience
      </a>
    </li>
    <li class="navbar__item">
      <a href="#education" class="navbar__link">
        Education
      </a>
    </li>
    <li class="navbar__item">
      <a href="#contact" class="navbar__link">
        Contact
      </a>
    </li>
  </ul>
</nav>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 10;
    margin-top: 1.5rem;
    padding: 0.6rem 0;
    background: var(--bg-color);
    border-top: 1px solid var(--cv-rule);
    border-bottom: 1px solid var(--cv-rule);
    font-size: 0.95rem;
  }

  .navbar__menu {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .navbar__hamburger,
  .navbar__toggle {
    display: none;
  }

  @media (max-width: 600px) {
    .navbar__menu {
      display: none;
    }

    .navbar__hamburger {
      display: block;
      cursor: pointer;
    }

    .navbar__toggle:checked + .navbar__hamburger + .navbar__menu {
      display: flex;
      flex-direction: column;
      margin-top: 0.5rem;
    }
  }
</style>
