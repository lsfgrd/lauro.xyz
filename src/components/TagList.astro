---
const tags = [
  "JavaScript",
  "TypeScript",
  "React",
  "NextJS",
  "Nest",
  "Node",
  "Angular",
  "C#",
  ".NET Core",
  "Java",
  "Scala",
  "Spring Boot",
  "GraphQL",
  "PostgreSQL",
  "MongoDB",
  "SQL Server",
  "WordPress",
  "Adobe Experience Manager",
  "Headless CMS",
  "Accessibility (WCAG)",
  "Web performance",
  "Design systems",
  "Claude Code",
  "MCP",
  "Agentic workflows",
];
---

<section id="technologies" class="technologies-section">
  <h2>Technologies I've Worked With</h2>
  <p>
    <em>1+ years of experience is considered</em>
  </p>
  <ul class="tech-list">
    {tags.map((tag) => (
      <li class="tech-item">{tag}</li>
    ))}
  </ul>
</section>

<style>
  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
  }

  .tech-item {
    padding: 0.15rem 0.6rem;
    font-size: 0.9rem;
    border: 1px solid var(--cv-rule, currentColor);
    border-radius: 999px;
  }
</style>
