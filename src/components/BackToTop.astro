<script>
  const backToTopBtn = document.getElementById("backToTopBtn");

  if (backToTopBtn) {
    window.addEventListener("scroll", () => {
      backToTopBtn.hidden = document.documentElement.scrollTop <= 400;
    });

    backToTopBtn.addEventListener("click", () => {
      window.scrollTo({ top: 0 });
    });
  }
</script>

<button id="backToTopBtn" class="btn" title="Go to top" hidden>↑ top</button>

<style>
  #backToTopBtn {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 99;
  }

  #backToTopBtn[hidden] {
    display: none;
  }
</style>
