---
import site from "../data/settings.js";
import { toISODate } from "../utils/date";

export interface Props {
  title: string;
  description: string;
  permalink: string;
  publishDate: Date | string;
  ogImageUrl?: string;
}

const {
  title,
  permalink = Astro.url.href,
  publishDate,
  ogImageUrl = `/og/${Astro.url.pathname.replace(/^\/|\/$/g, "")}.png`,
  description,
} = Astro.props;

const ldData = {
  "@context": "https://schema.org",
  "@type": "Article",
  publisher: {
    "@type": "Organization",
    name: `${site.name}`,
    url: `${site.url}`,
  },
  author: {
    "@type": "Person",
    name: `${site.name}`,
    url: `${site.url}/about/`,
    sameAs: [`${site.url}`, `${site.githubURL}`],
  },
  headline: `${title}`,
  url: `${permalink}`,
  datePublished: toISODate(publishDate),
  image: {
    "@type": "ImageObject",
    url: `${site.url}${ogImageUrl}`,
    width: 3600,
    height: 1890,
  },
  description: `${description}`,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `${permalink}`,
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(ldData)} is:inline></script>
